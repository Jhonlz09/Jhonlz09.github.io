---
import Section from "../Section.astro"
import AstroIcon from "@/icons/AstroIcon.astro"
import SolidJS from "@/icons/SolidJS.astro"
import React from "@/icons/react.astro"
import Next from "@/icons/next.astro"
import Tailwind from "@/icons/tailwind.astro"
import Node from "@/icons/node.astro"
import Bun from "@/icons/Bun.astro"
import Elysia from "@/icons/Elysia.astro"
import Php from "@/icons/php.astro"
import Redis from "@/icons/Redis.astro"
import PostgreSQL from "@/icons/PostgreSQL.astro"
import MySQL from "@/icons/sql.astro"
import Drizzle from "@/icons/Drizzle.astro"
import TanStack from "@/icons/TanStack.astro"
import TypeScript from "@/icons/type.astro"
import Python from "@/icons/python.astro"
import Git from "@/icons/git.astro"
import GitHub from "@/icons/GitHub.astro"
import Docker from "@/icons/Docker.astro"
import CSharp from "@/icons/CSharp.astro"
import DotNet from "@/icons/DotNet.astro"
import Azure from "@/icons/Azure.astro"
import SqlServer from "@/icons/SqlServer.astro"
import PowerShell from "@/icons/PowerShell.astro"
import AzureDevOps from "@/icons/AzureDevOps.astro"
import WindowsServer from "@/icons/WindowsServer.astro"
import ActiveDirectory from "@/icons/ActiveDirectory.astro"

import { skills } from "@cv"

const SKILLS_ICONS: Record<string, (_props: Record<string, unknown>) => unknown> = {
  Astro: AstroIcon,
  SolidJS,
  React,
  "Next.js": Next,
  "Tailwind CSS": Tailwind,
  "Node.js": Node,
  Bun,
  Elysia,
  PHP: Php,
  Redis,
  PostgreSQL,
  MySQL,
  "Drizzle ORM": Drizzle,
  TanStack,
  TypeScript,
  Python,
  Git,
  GitHub,
  Docker,
  "C#": CSharp,
  ".NET": DotNet,
  Azure,
  "Microsoft Azure": Azure,
  "SQL Server": SqlServer,
  PowerShell,
  "Azure DevOps": AzureDevOps,
  "Windows Server": WindowsServer,
  "Active Directory": ActiveDirectory
}

const { class: className } = Astro.props;
---

<Section title="Stack Tecnológico" class={`skills-section ${className || ''}`}>
  <div class="skills-container">
    {
      skills.map(({ name, keywords }) => (
        <div class="skill-group">
          <h3>{name}</h3>
          <ul class="keywords-list">
            {keywords.map((keyword) => {
              const Icon = SKILLS_ICONS[keyword]

              return (
                <li class="skill-tag">
                  {Icon && <Icon />}
                  <span>{keyword}</span>
                </li>
              )
            })}
          </ul>
        </div>
      ))
    }
  </div>
</Section>

<style>
  .skills-container {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .skill-group {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .skill-group h3 {
    font-size: var(--fs-xs);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .keywords-list {
    display: flex;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }

  .skill-tag {
    align-items: center;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    display: inline-flex;
    font-size: var(--fs-xs);
    font-weight: 500;
    gap: var(--sp-2);
    padding: 6px 10px;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .skill-tag:hover {
    border-color: var(--border-default);
  }

  .skill-tag :global(svg) {
    width: 14px;
    height: 14px;
    color: var(--text-secondary);
    flex-shrink: 0;
  }

  @media print {
    .skill-tag {
      background: transparent !important;
      border: 1px solid #e4e4e7 !important;
      color: #000 !important;
    }
    .skill-tag :global(svg) {
      color: #000 !important;
    }
    .skill-group h3 {
      color: #52525b !important;
    }
  }
</style>
