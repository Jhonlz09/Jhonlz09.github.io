---
import Section from "../Section.astro";
import Phone from "@/icons/Phone.astro";
import Mail from "@/icons/Mail.astro";
import { references } from "@cv";

const { class: className } = Astro.props;
---

{
  references && references.length > 0 && (
    <Section
      title="Referencias Laborales & Personales"
      class={`references-section ${className || ""}`}
    >
      <ul class="references-grid">
        {references.map(
          ({ name, type, phone, title, company, area, email, reference }) => {
            const isWork = type?.toLowerCase() === "laboral";

            return (
              <li class="ref-item">
                <article class="ref-card">
                  <header class="ref-header">
                    <div class="ref-info">
                      <div class="ref-name-row">
                        <h3>{name}</h3>
                        <span
                          class={`type-badge ${isWork ? "badge-laboral" : "badge-personal"}`}
                        >
                          {type || "Referencia"}
                        </span>
                      </div>

                      {title && <h4 class="ref-title">{title}</h4>}

                      {(company || area) && (
                        <p class="ref-org">
                          {company}
                          {company && area && " · "}
                          {area && <span class="ref-area">{area}</span>}
                        </p>
                      )}
                    </div>
                  </header>

                  {reference && <p class="ref-comment">{reference}</p>}

                  <footer class="ref-contact">
                    {phone && (
                      <a
                        href={`tel:${phone}`}
                        class="contact-chip phone-chip"
                        title={`Llamar a ${name}`}
                        aria-label={`Llamar a ${name} al ${phone}`}
                      >
                        <Phone />
                        <span class="phone-number">{phone}</span>
                      </a>
                    )}

                    {email && (
                      <a
                        href={`mailto:${email}`}
                        class="contact-chip email-chip"
                        title={`Enviar correo a ${name}`}
                        aria-label={`Enviar correo a ${name}`}
                      >
                        <Mail />
                        <span class="email-address">{email}</span>
                      </a>
                    )}
                  </footer>
                </article>
              </li>
            );
          }
        )}
      </ul>
    </Section>
  )
}

<style>
  .references-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-4);
  }

  .ref-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--sp-4) var(--sp-5);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--sp-3);
    height: 100%;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .ref-card:hover {
    border-color: var(--border-default);
  }

  .ref-header {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .ref-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ref-name-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }

  .ref-info h3 {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .ref-title {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .ref-org {
    font-size: var(--fs-xs);
    color: var(--text-tertiary);
    font-weight: 400;
  }

  .ref-area {
    color: var(--text-muted);
  }

  /* ─── Type Badges ─── */
  .type-badge {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .badge-laboral {
    background: rgba(56, 189, 248, 0.12);
    color: var(--accent-primary);
    border: 1px solid rgba(56, 189, 248, 0.25);
  }

  .badge-personal {
    background: rgba(161, 161, 170, 0.1);
    color: var(--text-secondary);
    border: 1px solid rgba(161, 161, 170, 0.2);
  }

  /* ─── Comments ─── */
  .ref-comment {
    font-size: var(--fs-xs);
    color: var(--text-secondary);
    line-height: 1.5;
    background: rgba(255, 255, 255, 0.02);
    border-left: 2px solid var(--border-default);
    padding: var(--sp-2) var(--sp-3);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  /* ─── Contact Chips ─── */
  .ref-contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin-top: auto;
    padding-top: var(--sp-2);
    border-top: 1px solid var(--border-subtle);
  }

  .contact-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    font-size: var(--fs-xs);
    font-weight: 500;
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-out);
    font-family: inherit;
  }

  .phone-chip {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
  }

  .phone-chip:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--border-hover);
    color: #ffffff;
  }

  .phone-chip :global(svg) {
    width: 13px;
    height: 13px;
    color: var(--accent-primary);
    flex-shrink: 0;
  }

  .email-chip {
    background: transparent;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .email-chip:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--border-default);
    color: var(--text-primary);
  }

  .email-chip :global(svg) {
    width: 13px;
    height: 13px;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .phone-number,
  .email-address {
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 700px) {
    .references-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-3);
    }

    .ref-card {
      padding: var(--sp-3) var(--sp-4);
    }
  }

  @media print {
    .references-grid {
      display: grid !important;
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 1rem !important;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .ref-card {
      background: transparent !important;
      border: 1px solid #e4e4e7 !important;
      padding: 0.5rem 0.75rem !important;
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .ref-info h3 {
      color: #000000 !important;
    }

    .ref-title {
      color: #27272a !important;
    }

    .ref-org,
    .ref-area {
      color: #52525b !important;
    }

    .type-badge {
      border: 1px solid #d4d4d8 !important;
      color: #000000 !important;
      background: #f4f4f5 !important;
    }

    .ref-comment {
      background: transparent !important;
      border-left: 2px solid #a1a1aa !important;
      color: #3f3f46 !important;
    }

    .ref-contact {
      border-top: 1px solid #e4e4e7 !important;
      padding-top: 0.35rem !important;
    }

    .contact-chip {
      background: transparent !important;
      border: 1px solid #e4e4e7 !important;
      color: #000000 !important;
      padding: 2px 6px !important;
    }

    .contact-chip :global(svg) {
      color: #000000 !important;
    }
  }
</style>
