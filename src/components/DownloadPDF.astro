---
import Download from "@/icons/Download.astro"
---

<button id="download-pdf-btn" class="no-print" title="Descargar Currículum (PDF ATS-friendly)" aria-label="Descargar Currículum">
  <Download />
  <span>Descargar CV</span>
</button>

<script>
  document.getElementById('download-pdf-btn')?.addEventListener('click', () => {
    window.print();
  });
</script>

<style>
  #download-pdf-btn {
    position: fixed;
    bottom: var(--sp-6);
    right: var(--sp-6);
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    background: var(--text-primary);
    color: var(--bg-base);
    border: 1px solid var(--text-primary);
    border-radius: var(--radius-full);
    padding: 0.6rem 1.1rem;
    font-size: var(--fs-xs);
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    transition: transform var(--duration-fast) var(--ease-out), background-color var(--duration-fast) var(--ease-out);
    z-index: 999;
    font-family: inherit;
  }

  #download-pdf-btn:hover {
    transform: translateY(-2px);
    background: #ffffff;
    border-color: #ffffff;
  }

  #download-pdf-btn :global(svg) {
    color: var(--bg-base);
  }

  @media (max-width: 700px) {
    #download-pdf-btn {
      bottom: var(--sp-4);
      right: var(--sp-4);
      padding: 0.6rem;
    }
    #download-pdf-btn span {
      display: none;
    }
  }

  @media print {
    #download-pdf-btn {
      display: none !important;
    }
  }
</style>
